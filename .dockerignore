# This file applies to the repository-root backend build context in compose.yaml.
# Keep backend/ and ml/ source available to backend/Dockerfile.
.git/
.env
.env.*
!.env.example
.venv/
venv/
__pycache__/
.pytest_cache/
backend/.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.py[cod]
*.egg-info/
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
**/htmlcov/
**/*.py[cod]
**/*.egg-info/
**/node_modules/
**/dist/
ml/generated/
ml/models/**
!ml/models/.gitkeep

# The frontend is built from its own context and is not needed by the backend.
frontend/

# Local data and generated verification output are never backend build inputs.
backups/
cloudflared.exe.exe
LOAD_*.json
STAGE10_*.json
STAGE11_*.json
.test-models/
*.log
**/*.log
*.db
*.sqlite
*.sqlite3
**/*.db
**/*.sqlite
**/*.sqlite3
# Protect nested local environment files as well as the root environment.
**/.env
**/.env.*
!**/.env.example
