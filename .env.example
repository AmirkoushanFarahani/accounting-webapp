# Copy this file to .env. Every value containing change-me is a non-secret placeholder.
# Generate unique production secrets; never commit the resulting .env file.
APP_ENV=development
APP_NAME=Azari Intelligent Accounting
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://azari:change-me@db:5432/azari
POSTGRES_DB=azari
POSTGRES_USER=azari
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-use-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_RATE_LIMIT_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# Per worker: at most 5 + 10 PostgreSQL connections. Budget across ALL workers.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=2
DB_CONNECT_TIMEOUT_SECONDS=5
# Async admission leaves sync worker capacity available for response/cleanup work.
DB_MAX_CONCURRENT_SESSIONS=15
DB_ADMISSION_TIMEOUT_SECONDS=1
# Optional development bootstrap. Set both or neither; never use known production credentials.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-unique-password
CORS_ORIGINS=["http://localhost:4173"]
ML_MODEL_DIR=/app/ml/models
ML_CONFIDENCE_THRESHOLD=0.65
VITE_API_URL=http://localhost:8100/api/v1
